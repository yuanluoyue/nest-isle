{
  "name": "nest-isle",
  "version": "1.0.0",
  "description": "Admin management system based on NestJS + React",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "scripts": {
    "docker:dev": "docker-compose -f docker/docker-compose.dev.yml up -d",
    "server:dev": "pnpm --filter server run start:dev",
    "admin:dev": "pnpm --filter admin run dev",
    "db:seed": "pnpm --filter server run db:seed",
    "docker:dev-all-up": "bash docker/dev.sh",
    "docker:dev-all-down": "bash docker/dev.sh down"
  },
  "packageManager": "pnpm@10.11.0"
}
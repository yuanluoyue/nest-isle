# 项目名称（kebab-case，用于派生 DB_NAME/JWT_SECRET/MINIO_BUCKET）
APP_NAME=nest-isle

# Database（DB_NAME 默认由 APP_NAME 派生，- 转 _）
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
# DB_NAME=nest_isle

# JWT（JWT_SECRET 默认为 ${APP_NAME}-secret）
# JWT_SECRET=nest-isle-secret
JWT_EXPIRES_IN=7d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# MinIO（MINIO_BUCKET 默认为 ${APP_NAME}）
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
# MINIO_USE_SSL=false
# MINIO_PUBLIC_URL=http://localhost:9000

# App
PORT=3000
